# Example nginx configuration for hosting the production build (dist/) on a gov.in server.
# Adjust the three lines marked "change", then test with `nginx -t`.
#
# Setup:
#   1. npm ci && npm run build            -> produces dist/
#   2. copy dist/ to the server           -> e.g. /var/www/bihar-heritage/dist
#   3. cp deploy/security-headers.conf /etc/nginx/snippets/bihar-heritage-security.conf
#   4. install this file as a server block and reload nginx

# Never reveal the nginx version.
server_tokens off;

# HTTP -> HTTPS
server {
    listen 80;
    server_name example.bihar.gov.in;                  # change
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name example.bihar.gov.in;                  # change
    root /var/www/bihar-heritage/dist;                 # change

    ssl_certificate     /etc/ssl/certs/bihar-heritage.crt;      # change
    ssl_certificate_key /etc/ssl/private/bihar-heritage.key;    # change
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # This is a read-only site: reject everything except GET and HEAD.
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }

    # Serve the .br / .gz files that `npm run build` pre-generates.
    brotli_static on;                                  # needs ngx_brotli; remove if unavailable
    gzip_static on;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Defaults for any path that does not set its own headers.
    include /etc/nginx/snippets/bihar-heritage-security.conf;

    # Never serve hidden files (.git, .env, ...).
    location ~ /\. { return 404; }

    # Hashed build files never change: cache for a year.
    # (A location that uses add_header must include the security headers again.)
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/bihar-heritage-security.conf;
        try_files $uri =404;
    }

    # Un-hashed photos that live in public/assets/heritage/ (more specific, so it wins over /assets/).
    location /assets/heritage/ {
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/bihar-heritage-security.conf;
        try_files $uri =404;
    }

    # Self-hosted photos and audio (renamed only when their content changes).
    location /images/ {
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/bihar-heritage-security.conf;
        try_files $uri =404;
    }
    location /audio/ {
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/bihar-heritage-security.conf;
        try_files $uri =404;
    }
    location /pdf-worker/ {
        add_header Cache-Control "public, max-age=604800";
        include /etc/nginx/snippets/bihar-heritage-security.conf;
        try_files $uri =404;
    }

    # Always revalidate the HTML so new releases show up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/bihar-heritage-security.conf;
    }

    # SPA fallback for client-side routes (the app shows its own 404 page).
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/bihar-heritage-security.conf;
        try_files $uri /index.html;
    }

    # MP4 byte-range requests are supported by default (video seeks without a full download).
}
